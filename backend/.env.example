# Copy to backend/.env and fill in. Never commit the real .env.
# Every key here maps 1:1 to a field in backend/app/core/config.py.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chadev:chadev@localhost:5432/chadev_buchhaltung
DATABASE_URL_SYNC=postgresql://chadev:chadev@localhost:5432/chadev_buchhaltung
# Dev/test only. Production refuses to start with this on — Alembic owns the schema.
AUTO_CREATE_TABLES=true

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-48-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ------------------------------------------------------------------
# Comma-separated. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- AI / Ollama -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to auto-detect a text model (vision models are excluded).
OLLAMA_CHAT_MODEL=

# --- Email (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=
