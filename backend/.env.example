# Copy to backend/.env and fill in. Never commit the real .env.
# Every key here maps 1:1 to a field in backend/app/core/config.py.

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://chadev:chadev@localhost:5432/chadev_buchhaltung
DATABASE_URL_SYNC=postgresql://chadev:chadev@localhost:5432/chadev_buchhaltung
# Dev/test only. Production refuses to start with this on — Alembic owns the schema.
AUTO_CREATE_TABLES=true

# --- Auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-random-48-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Rate limiting ---------------------------------------------------------
# "<count>/<period>". Keyed per tenant for logged-in calls, per IP otherwise.
# DEFAULT: every route · CLASSIFY: ML inference · HEAVY: OCR/vision, PDF, training, LLM
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_CLASSIFY=60/minute
RATE_LIMIT_HEAVY=30/minute

# --- CORS ------------------------------------------------------------------
# Comma-separated. No wildcards in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- AI / Ollama -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to auto-detect a text model (vision models are excluded).
OLLAMA_CHAT_MODEL=

# --- Email (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- Observability (optional) ---------------------------------------------
SENTRY_DSN=

# --- Platform: SSO + events (chadev-platform/contracts/sso.md, events.md) --
# Shared with billing's .env, NOT the JWT_SECRET. Verifies the SSO hand-off
# token (POST /api/auth/sso) and the HMAC on inbound events
# (POST /api/platform/events). Empty = both endpoints answer 404.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_SHARED_SECRET=
# App switcher "Billing" entry (backend side, informational). The frontend
# needs NEXT_PUBLIC_BILLING_URL (frontend/.env.local) — Next only inlines
# NEXT_PUBLIC_* at build time. Empty = no entry.
BILLING_URL=

# --- Background jobs -------------------------------------------------------
# true:  scheduler + training worker run inside the API process (dev default).
# false: run `python -m app.worker` as its own process (compose `worker` service).
RUN_WORKER_IN_API=true
WORKER_POLL_INTERVAL=5

# --- Storage (uploads, model artifacts) -----------------------------------
# local: files under STORAGE_LOCAL_DIR (single replica only).
# s3:    any S3-compatible bucket (AWS, MinIO, R2) — required for >1 replica.
STORAGE_BACKEND=local
# Default: <backend>/data (= /app/data in Docker). Override only for another disk.
#STORAGE_LOCAL_DIR=/var/lib/buchhaltung
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Ollama timeouts (B-32) ---------------------------------------------------
# Every call to Ollama has one; an upstream that hangs must not hold a request
# open for ever. The vision model is the slow one — a scanned A4 page takes
# tens of seconds — so it gets its own, and the reachability probe gets a short
# one because it runs on every status check.
OLLAMA_TIMEOUT=60
OLLAMA_VISION_TIMEOUT=120
OLLAMA_PROBE_TIMEOUT=10

# --- Migrations run as a different role than the app (B-24) -------------------
# The app connects as `app_rw`, which is NOSUPERUSER NOBYPASSRLS so the
# row-level-security policies actually apply to it. That role may not create
# tables, so Alembic needs the owner's URL. In production the app REFUSES TO
# BOOT when this is empty or equal to DATABASE_URL — see docs/ADR-002-rls.md.
# Leave it empty outside production, where one role does both.
MIGRATION_DATABASE_URL=
