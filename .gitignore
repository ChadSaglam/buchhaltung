# Dependencies
node_modules/
backend/venv/
__pycache__/
*.pyc

# Environment
.env
.env.local
.env.production

# Database
*.db
*.sqlite3
# Playwright's throw-away backend storage (frontend/playwright.config.ts)
backend/e2e-data/

# ML models
*.pkl
backend/ml_models/
backend/data/

# Build
# Every NEXT_DIST_DIR, not only the two we name: `make check` builds into
# .next-e2e/, and a one-off verification build leaves its own behind —
# which is how 1265 files from a .next-sa/ once made it into a commit.
.next*/
out/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
docker-compose.override.yml

# Logs
*.log

# OS
Thumbs.db

# Generated API contract (intermediate)
backend/openapi.json

# Local scratch
_to_delete/
graphify-out/

# Test database
.pytest-test.db

# Playwright
frontend/playwright-report/
frontend/test-results/

# Coverage
.coverage
coverage.xml
htmlcov/

# TS build info
frontend/tsconfig.tsbuildinfo

# Session scratch
.scratch/

# Local AI-assistant scratch (never commit)
*outputs/

# Generated by `next dev`, not source
frontend/AGENTS.md
frontend/CLAUDE.md

# AI-assistant skills/plugins vendored locally (never commit)
.claude/
design-system/
.pytest-test.db-journal

# B-25: backups are data, not source. Keep the directory out of git entirely —
# a dump committed by accident is every tenant's bookkeeping in the history.
/backups/

# --- 2026-09-17: hygiene sweep ---

# macOS metadata, anywhere. The bare `.DS_Store` rule above never matched
# `frontend/.DS_Store`, which was committed before that rule existed — a
# gitignore rule does nothing to a file git is already tracking.
**/.DS_Store

# Tree dumps and scratch inventories generated to hand to a tool: 20k+ lines
# of derived text, a diff nobody reads and a merge conflict nobody can resolve.
structure.txt
tree.txt
/*.patch
/*.bundle
/*.tgz

# Tool caches. Each drops its own .gitignore, so this is belt and braces —
# but a cache that survives one `rm -rf` of that file gets committed.
.pytest_cache/
.ruff_cache/
backend/.ruff_cache/
.mypy_cache/

# Virtualenvs by any name, not only backend/venv/.
venv/
.venv/
env/

# TypeScript incremental build state, wherever tsc puts it.
*.tsbuildinfo

# Working material for the first end-to-end run: real ledgers, real receipts,
# real payslips. Never in git — it is a customer's bookkeeping.
tour/
