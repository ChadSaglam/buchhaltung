# Variables `docker compose` reads from the repo-root .env (B-41).
# The backend's own settings are documented in backend/.env.example.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=                      # required, >= 32 random chars (JWT signing)
POSTGRES_PASSWORD=               # required, password of the compose `db` user `chadev`

# URLs as the *browser* sees them (NEXT_PUBLIC_* is inlined at build time).
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BILLING_URL=                     # ChaDev billing app; empty hides the "Apps" switcher
PLATFORM_SHARED_SECRET=          # same value as in billing; empty disables SSO + events

# Optional e-mail delivery of exports
SMTP_HOST=
SMTP_PORT=465                    # 465 = implicit TLS (default), 587 = STARTTLS
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- E-mail intake (B-69) -----------------------------------------------------
# One mailbox for the whole deployment; the tenant sits in the address:
# belege+<tenant-slug>@<EMAIL_INTAKE_DOMAIN>. No domain = intake is off.
EMAIL_INTAKE_DOMAIN=              # e.g. rechnungen.example.ch
EMAIL_INTAKE_LOCALPART=belege
# Option 1 — poll a mailbox (works with any provider):
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_BATCH=20
EMAIL_POLL_INTERVAL=300           # seconds between two polls (worker)
# Option 2 — a mail provider's webhook (Postmark/Mailgun) on
# POST /api/email/inbound with the X-Mail-Secret header. Empty = route is closed.
EMAIL_INBOUND_SECRET=

# Optional OmniRoute gateway (`docker compose --profile gateway up omniroute`)
OMNIROUTE_MEMORY_MB=2048

# --- Rate limiting and the proxy hop (B-55) ---------------------------------
# Sign-in, sign-up and the SSO hand-off are the only unauthenticated write
# paths; they get their own per-IP bucket, far below RATE_LIMIT_DEFAULT.
RATE_LIMIT_AUTH=10/minute
# Where the rate-limit counters live. Empty = in this process, which is right
# for one uvicorn worker and quietly wrong for two (each would grant the full
# quota). compose already runs redis.
REDIS_URL=
# Behind a reverse proxy every request arrives from the proxy, so the per-IP
# limit would key on the proxy. Set this to the proxy's address (or the docker
# network) so uvicorn believes X-Forwarded-For from that hop and no other.
# Empty = trust nobody, which is the right default with no proxy in front.
FORWARDED_ALLOW_IPS=
