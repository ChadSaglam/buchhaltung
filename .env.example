# Variables `docker compose` reads from the repo-root .env (B-41).
# The backend's own settings are documented in backend/.env.example.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=                      # required, >= 32 random chars (JWT signing)
POSTGRES_PASSWORD=               # required, password of the compose `db` user `chadev`

# URLs as the *browser* sees them (NEXT_PUBLIC_* is inlined at build time).
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
BILLING_URL=                     # ChaDev billing app; empty hides the "Apps" switcher
PLATFORM_SHARED_SECRET=          # same value as in billing; empty disables SSO + events

# Optional e-mail delivery of exports
SMTP_HOST=
SMTP_PORT=465                    # 465 = implicit TLS (default), 587 = STARTTLS
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# Optional OmniRoute gateway (`docker compose --profile gateway up omniroute`)
OMNIROUTE_MEMORY_MB=2048
